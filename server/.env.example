# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Solo local / servidores tradicionales (Railway, Render, VPS). Vercel no los necesita:
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Solo si usas Turso (requerido en Vercel; opcional en local, donde por defecto
# se usa un archivo SQLite local si se dejan vacíos):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
